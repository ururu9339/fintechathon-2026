# Copy to .env for local development. Use a long random value and keep it private.
QYZEAI_JWT_SECRET=replace-with-a-long-random-secret

# Optional: enables dossier narrative generation.
OPENAI_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# Optional local database override.
DATABASE_URL=postgresql+psycopg://qyzeai:qyzeai@localhost:5432/qyzeai

# Transactional email delivery (required for verification and password reset in deployment).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
